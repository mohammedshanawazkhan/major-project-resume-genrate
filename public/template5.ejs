<% layout("/layouts/boilerplate") %>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
/* background:#ececec; */
padding:20px;
}

.resume{
max-width:900px;
margin:auto;
background:white;
display:grid;
grid-template-columns:38% 62%;
box-shadow:0 10px 30px rgba(0,0,0,.12);
position:relative;
overflow:hidden;
}

/* Header */

.header{
position:absolute;
top:55px;
left:0;
width:100%;
height:170px;
background:#2d2d3f;
z-index:1;
}

.left{
background:#dedede;
padding:220px 35px 35px;
position:relative;
z-index:2;
}

.right{
padding:95px 40px 40px;
position:relative;
z-index:2;
background:#fff;
}

/* Profile */

.photo{
position:absolute;
top:25px;
left:30px;
z-index:3;
}

.photo img{
width:180px;
height:180px;
border-radius:50%;
object-fit:cover;
border:6px solid white;
}

/* Name */

.name{
margin-top:5px;
font-size:46px;
font-weight:700;
color:white;
position:relative;
z-index:3;
}

.name span{
font-weight:300;
}

.role{
font-size:20px;
color:white;
margin-top:6px;
position:relative;
z-index:3;
}

/* Left */

.section-left{
margin-bottom:45px;
}

.section-left h2{
font-size:18px;
font-weight:700;
display:flex;
align-items:center;
gap:12px;
margin-bottom:20px;
}

.section-left h2 i{
font-size:22px;
}

.section-left p{
line-height:1.8;
color:#333;
font-size:15px;
text-align:justify;
}

.contact div{
display:flex;
align-items:flex-start;
gap:12px;
margin:16px 0;
font-size:15px;
}

.contact i{
font-size:18px;
margin-top:4px;
}

.contact span{
word-break:break-word;
}

.section-left ul{
padding-left:20px;
}

.section-left li{
margin:10px 0;
}

/* Right */

.section-right{
margin-top:35px;
}

.section-title{
display:flex;
align-items:center;
gap:12px;
font-size:18px;
font-weight:700;
margin-bottom:25px;
}

.section-title i{
font-size:24px;
}

.timeline{
position:relative;
padding-left:38px;
}

.timeline::before{
content:"";
position:absolute;
left:10px;
top:0;
bottom:0;
width:2px;
background:#777;
}

.item{
position:relative;
margin-bottom:35px;
}

.item::before{
content:"";
position:absolute;
left:-34px;
top:7px;
width:14px;
height:14px;
background:#2d2d3f;
border-radius:50%;
}

.year{
font-size:15px;
font-weight:600;
margin-bottom:5px;
}

.item h3{
font-size:19px;
font-weight:700;
margin-bottom:5px;
}

.item h4{
font-size:16px;
margin-bottom:8px;
color:#333;
}

.item p{
line-height:1.7;
color:#444;
}

.item ul{
margin-top:10px;
padding-left:22px;
}

.item li{
margin:8px 0;
}

@media(max-width:850px){

.resume{
grid-template-columns:1fr;
}

.header{
position:relative;
height:250px;
}

.photo{
left:50%;
transform:translateX(-50%);
}

.left{
padding-top:40px;
}

.right{
padding-top:30px;
}

.name{
margin-top:120px;
text-align:center;
}

.role{
text-align:center;
}

}

@page{
size:A4;
margin:0;
}

@media print{

body{
padding:0;
background:white;
}

.resume{
box-shadow:none;
width:210mm;
min-height:297mm;
}

}
.resume-actions {
      max-width: 1000px;
      margin: 20px auto;
      text-align: right;
    }
    .resume-actions button {
      background: #0078d7;
      color: #fff;
      border: none;
      padding: 10px 18px;
      margin-left: 10px;
      border-radius: 6px;
      font-size: 14px;
      cursor: pointer;
      transition: background 0.3s;
    }
    .resume-actions button:hover {
      background: #005fa3;
    }
    .resume-actions i {
      margin-right: 6px;
    }

  /* RESPONSIVE */
  @media (max-width: 850px) {
    .resume {
      grid-template-columns: 1fr;
    }
    .left {
      text-align: center;
    }
    .contact div {
      justify-content: center;
    }
  }
</style>
</head>

<body>

<div class="resume">

<div class="header"></div>

<div class="photo">
<img src="<%= data.profileImage.url %>" alt="<%= data.name %>">
</div>

<!-- LEFT -->

<div class="left">

<div class="section-left">

<h2><i class="fas fa-user"></i> About Me</h2>

<p><%= data.summary %></p>

</div>

<div class="section-left">

<h2><i class="far fa-address-card"></i> Contact</h2>

<div class="contact">

<div><i class="fas fa-phone"></i><span><%= data.phone %></span></div>

<div><i class="fas fa-envelope"></i><span><%= data.email %></span></div>

<div><i class="fas fa-location-dot"></i><span><%= data.address %></span></div>

<div><i class="fab fa-linkedin"></i><span><%= data.linkedin %></span></div>

<div><i class="fab fa-github"></i><span><%= data.github %></span></div>

</div>

</div>

<div class="section-left">

<h2><i class="fas fa-gear"></i> Skills</h2>

<ul>
<li><%= data.skills %></li>
</ul>

</div>

<div class="section-left">

<h2><i class="fas fa-language"></i> Languages</h2>

<ul>
<li>English</li>
<li>Hindi</li>
<li>Telugu</li>
</ul>

</div>

<div class="section-left">

<h2><i class="fas fa-heart"></i> Hobbies</h2>

<ul>
<li><%= data.hobby1 %></li>
<li><%= data.hobby2 %></li>
<li><%= data.hobby3 %></li>
</ul>

</div>

</div>

<!-- RIGHT -->

<div class="right">

<div class="name">
<%= data.name.split(' ')[0] %><br>
<span><%= data.name.split(' ').slice(1).join(' ') %></span>
</div>

<div class="role">Full Stack Developer</div>

<div class="section-right">

<div class="section-title">
<i class="fas fa-graduation-cap"></i>
<span>Education</span>
</div>

<div class="timeline">

<div class="item">

<div class="year"><%= data.education[0].year %></div>

<h3><%= data.education[0].institution %></h3>

<h4><%= data.education[0].degree %></h4>

<p><%= data.education[0].specialization %></p>

</div>

</div>

</div>

<div class="section-right">

<div class="section-title">
<i class="fas fa-briefcase"></i>
<span>Experience</span>
</div>

<div class="timeline">

<div class="item">

<div class="year">
<%= data.experience[0].startDate %> - <%= data.experience[0].endDate %>
</div>

<h3><%= data.experience[0].title %></h3>

<h4><%= data.experience[0].company %></h4>

<ul>
<li><%= data.experience[0].responsibilities %></li>
</ul>

</div>

</div>

</div>

<div class="section-right">

<div class="section-title">
<i class="fas fa-code"></i>
<span>Projects</span>
</div>

<div class="item">

<h3><%= data.projectTitle %></h3>

<p><%= data.projectDescription %></p>

<p><strong>Tech:</strong> <%= data.projectTech %></p>

<p><strong>Link:</strong> <%= data.projectLink %></p>

</div>

</div>

<div class="section-right">

<div class="section-title">
<i class="fas fa-user-check"></i>
<span>Reference</span>
</div>

<div class="item">

<h3><%= data.refName1 %></h3>

<h4><%= data.refRelation %></h4>

<p><%= data.refContact1 %></p>

</div>

</div>

</div>

</div>
 <form action="/resume/<%=data._id%>/edit">
        <div class="resume-actions">
    <button onclick="window.location.href='/resume/edit/<%= data._id %>'">
      <i class="fas fa-edit"></i> Edit
  </div>
       </form>
       <form action="">
        <div class="resume-actions">
         </button>
    <button onclick="window.print()">
      <i class="fas fa-print"></i> Print
    </button>
       </form>
         </div>

</body>