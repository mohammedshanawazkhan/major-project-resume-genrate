<% layout("/layouts/boilerplate") %>


<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

body{
/* background:#ececec; */
padding:20px;
}

.resume{
width:900px;
margin:auto;
background:white;
position:relative;
overflow:hidden;
box-shadow:0 8px 30px rgba(0,0,0,.15);
}

/* top beige triangle */

.resume::before{
content:"";
position:absolute;
top:0;
right:0;
width:100%;
height:250px;
background:#d8c8ba;
clip-path:polygon(40% 0,100% 0,100% 100%);
z-index:0;
}

/* bottom beige triangle */

.resume::after{
content:"";
position:absolute;
bottom:0;
left:0;
width:220px;
height:170px;
background:#d8c8ba;
clip-path:polygon(0 100%,100% 100%,0 0);
}

.header{
position:relative;
z-index:2;
text-align:center;
padding:30px 40px 20px;
}

.header h1{
font-size:48px;
font-weight:700;
}

.header p{
font-size:18px;
letter-spacing:5px;
margin-top:6px;
}

.profile{
margin-top:25px;
}

.profile img{
width:180px;
height:180px;
border-radius:50%;
object-fit:cover;
}

.content{
display:grid;
grid-template-columns:35% 65%;
gap:35px;
padding:10px 40px 40px;
position:relative;
z-index:2;
}

.left p{
line-height:1.7;
text-align:justify;
margin-bottom:35px;
}

.section{
margin-bottom:40px;
}

.section h2{
font-size:18px;
font-weight:700;
margin-bottom:18px;
}

.section ul{
padding-left:20px;
}

.section li{
margin:8px 0;
}

.right .contact div{
display:flex;
align-items:center;
gap:15px;
margin-bottom:18px;
font-size:16px;
}

.contact i{
width:25px;
font-size:20px;
}

.right .section{
border-top:1px solid #ddd;
padding-top:25px;
}

.edu-item h3,
.exp-item h3,
.project h3,
.reference h3{
font-size:20px;
margin-bottom:8px;
}

.edu-item p,
.exp-item p,
.project p,
.reference p{
margin-bottom:8px;
line-height:1.6;
}

.info{
display:flex;
align-items:center;
gap:10px;
margin-top:8px;
}

.info i{
color:#444;
}

.info a{
color:#333;
text-decoration:none;
word-break:break-word;
}

.lang{
margin-bottom:12px;
}

.bar{
height:8px;
background:#eee;
border-radius:10px;
margin-top:5px;
overflow:hidden;
}

.fill{
height:100%;
background:#d8c8ba;
border-radius:10px;
}

@media(max-width:900px){

.resume{
width:100%;
}

.content{
grid-template-columns:1fr;
}

.header h1{
font-size:36px;
}

}

@page{
size:A4;
margin:0;
}

@media print{

body{
background:white;
padding:0;
}

.resume{
box-shadow:none;
width:210mm;
min-height:297mm;
}

}
.resume-actions {
      max-width: 1000px;
      margin: 20px auto;
      text-align: right;
    }
    .resume-actions button {
      background: #0078d7;
      color: #fff;
      border: none;
      padding: 10px 18px;
      margin-left: 10px;
      border-radius: 6px;
      font-size: 14px;
      cursor: pointer;
      transition: background 0.3s;
    }
    .resume-actions button:hover {
      background: #005fa3;
    }
    .resume-actions i {
      margin-right: 6px;
    }

  /* RESPONSIVE */
  @media (max-width: 850px) {
    .resume {
      grid-template-columns: 1fr;
    }
    .left {
      text-align: center;
    }
    .contact div {
      justify-content: center;
    }
  }
</style>

</head>

<body>

<div class="resume">

<div class="header">

<h1><%= data.name %></h1>

<p>Full Stack Developer</p>

<div class="profile">
<img src="<%= data.profileImage.url %>" alt="<%= data.name %>">
</div>

</div>

<div class="content">

<!-- LEFT -->

<div class="left">

<p><%= data.summary %></p>

<div class="section">

<h2>SKILLS</h2>

<ul>
<li><%= data.skills %></li>
</ul>

</div>

<div class="section">

<h2>LANGUAGES</h2>

<div class="lang">
English
<div class="bar"><div class="fill" style="width:95%"></div></div>
</div>

<div class="lang">
Hindi
<div class="bar"><div class="fill" style="width:85%"></div></div>
</div>

<div class="lang">
Telugu
<div class="bar"><div class="fill" style="width:75%"></div></div>
</div>

</div>

<div class="section">

<h2>INTERESTS</h2>

<ul>
<li><%= data.hobby1 %></li>
<li><%= data.hobby2 %></li>
<li><%= data.hobby3 %></li>
</ul>

</div>

</div>

<!-- RIGHT -->

<div class="right">

<div class="contact">

<div><i class="fas fa-phone"></i><span><%= data.phone %></span></div>

<div><i class="fas fa-envelope"></i><span><%= data.email %></span></div>

<div><i class="fas fa-location-dot"></i><span><%= data.address %></span></div>

<div><i class="fab fa-linkedin"></i><span><%= data.linkedin %></span></div>

<div><i class="fab fa-github"></i><span><%= data.github %></span></div>

</div>

<div class="section">

<h2>EDUCATION</h2>

<div class="edu-item">

<h3><%= data.education[0].degree %></h3>

<p><strong><%= data.education[0].institution %></strong></p>

<p><%= data.education[0].year %></p>

<p><%= data.education[0].specialization %></p>

</div>

</div>

<div class="section">

<h2>EXPERIENCE</h2>

<div class="exp-item">

<h3><%= data.experience[0].title %></h3>

<p><strong><%= data.experience[0].company %></strong></p>

<p><%= data.experience[0].startDate %> - <%= data.experience[0].endDate %></p>

<p><%= data.experience[0].responsibilities %></p>

</div>

</div>

<div class="section">

<h2>PROJECTS</h2>

<div class="project">

<h3><%= data.projectTitle %></h3>

<p><%= data.projectDescription %></p>

<div class="info">
<i class="fas fa-layer-group"></i>
<span><%= data.projectTech %></span>
</div>

<div class="info">
<i class="fas fa-link"></i>
<a href="<%= data.projectLink %>"><%= data.projectLink %></a>
</div>

</div>

</div>

<div class="section">

<h2>REFERENCE</h2>

<div class="reference">

<h3><%= data.refName1 %></h3>

<p><%= data.refRelation %></p>

<div class="info">
<i class="fas fa-phone"></i>
<span><%= data.refContact1 %></span>
</div>

</div>

</div>

</div>

</div>

</div>
 <form action="/resume/<%=data._id%>/edit">
        <div class="resume-actions">
    <button onclick="window.location.href='/resume/edit/<%= data._id %>'">
      <i class="fas fa-edit"></i> Edit
  </div>
       </form>
       <form action="">
        <div class="resume-actions">
         </button>
    <button onclick="window.print()">
      <i class="fas fa-print"></i> Print
    </button>
       </form>
         </div>

</body>
