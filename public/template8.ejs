<% layout("/layouts/boilerplate") %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= data.name %> - Resume</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"/>
  <style>
  body {
    font-family: 'Poppins', sans-serif;
    background: #f2f2f2;
    margin: 0;
    padding: 20px;
  }

  .resume {
    max-width: 1000px;
    margin: auto;
    display: grid;
    grid-template-columns: 340px 1fr;
    background: #fff;
    box-shadow: 0 8px 25px rgba(0,0,0,.15);
    border-radius: 10px;
    overflow: hidden;
  }

  /* LEFT COLUMN */
  .left {
    background: #111;
    color: #fff;
    padding: 35px 30px;
  }

  .photo {
    text-align: center;
    margin-bottom: 25px;
  }

  .photo img {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: 5px solid #d4af37;
    object-fit: cover;
  }

  .name {
    font-size: 26px;
    font-weight: 700;
    text-align: center;
    margin-bottom: 5px;
  }

  .role {
    text-align: center;
    font-size: 16px;
    color: #ccc;
    margin-bottom: 20px;
  }

  .summary {
    font-size: 14px;
    line-height: 1.7;
    text-align: justify;
    color: #ddd;
    margin-bottom: 25px;
  }

  .contact {
    margin-top: 20px;
  }

  .contact div {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 10px 0;
    font-size: 14px;
  }

  .contact i {
    color: #d4af37;
    font-size: 18px;
  }

  .side-section {
    margin-top: 25px;
  }

  .side-title {
    font-weight: 700;
    font-size: 16px;
    color: #d4af37;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .side-section ul {
    list-style: none;
    padding-left: 0;
  }

  .side-section li {
    margin: 6px 0;
    font-size: 14px;
  }

  /* RIGHT COLUMN */
  .right {
    background: #fff;
    padding: 40px 35px;
  }

  .section {
    margin-bottom: 30px;
  }

  .heading {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 15px;
  }

  .heading .icon {
    width: 45px;
    height: 45px;
    background: linear-gradient(90deg, #d4af37, #b8860b);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 20px;
  }

  .heading h2 {
    font-size: 18px;
    font-weight: 700;
    color: #333;
    text-transform: uppercase;
  }

  .exp-item {
    margin-bottom: 15px;
  }

  .exp-item h3 {
    font-size: 16px;
    color: #003a80;
    margin-bottom: 5px;
  }

  .exp-item p {
    font-size: 14px;
    color: #444;
    margin: 3px 0;
  }

  .project h3 {
    font-size: 16px;
    color: #003a80;
    margin-bottom: 5px;
  }

  .project p {
    font-size: 14px;
    color: #444;
    line-height: 1.6;
  }

  .info-line {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #003a80;
    font-size: 14px;
    margin: 5px 0;
  }

  .reference h3 {
    font-size: 16px;
    color: #003a80;
    margin-bottom: 5px;
  }

  .reference p {
    font-size: 14px;
    color: #444;
    margin: 3px 0;
  }

  /* GOLD GRADIENT HEADERS */
  .right h3,
  .side-title {
    background: linear-gradient(90deg, #d4af37, #b8860b);
    /* -webkit-background-clip: text; */
    -webkit-text-fill-color: transparent;
  }
  .resume-actions {
      max-width: 1000px;
      margin: 20px auto;
      text-align: right;
    }
    .resume-actions button {
      background: #0078d7;
      color: #fff;
      border: none;
      padding: 10px 18px;
      margin-left: 10px;
      border-radius: 6px;
      font-size: 14px;
      cursor: pointer;
      transition: background 0.3s;
    }
    .resume-actions button:hover {
      background: #005fa3;
    }
    .resume-actions i {
      margin-right: 6px;
    }

  /* RESPONSIVE */
  @media (max-width: 850px) {
    .resume {
      grid-template-columns: 1fr;
    }
    .left {
      text-align: center;
    }
    .contact div {
      justify-content: center;
    }
  }
</style>

<body>
  <div class="resume">
    <div class="left">
      <div class="photo">
        <img src="<%= data.profileImage.url %>" alt="<%= data.name %>">
      </div>
      <div class="contact">
        <div><i class="fas fa-phone"></i> <span><%= data.phone %></span></div>
        <div><i class="fas fa-envelope"></i> <span><%= data.email %></span></div>
        <div><i class="fas fa-location-dot"></i> <span><%= data.address %></span></div>
        <% if (data.linkedin) { %>
          <div><i class="fab fa-linkedin"></i> <span><%= data.linkedin %></span></div>
        <% } %>
        <% if (data.github) { %>
          <div><i class="fab fa-github"></i> <span><%= data.github %></span></div>
        <% } %>
      </div>

      <div class="side-section">
        <div class="side-title"><i class="fas fa-gear"></i><span>Skills</span></div>
        <ul>
          <% data.skills.forEach(skill => { %>
            <li><%= skill %></li>
          <% }) %>
        </ul>
      </div>

      <div class="side-section">
        <div class="side-title"><i class="fas fa-graduation-cap"></i><span>Education</span></div>
        <% data.education.forEach(edu => { %>
          <h3><%= edu.degree %></h3>
          <p><%= edu.specialization %></p>
          <p><%= edu.institution %></p>
          <p><%= edu.year %></p>
        <% }) %>
      </div>

      <div class="side-section">
        <div class="side-title"><i class="fas fa-heart"></i><span>Hobbies</span></div>
        <ul>
          <li><%= data.hobby1 %></li>
          <li><%= data.hobby2 %></li>
          <li><%= data.hobby3 %></li>
        </ul>
      </div>
    </div>

    <div class="right">
      <div class="name"><%= data.name %></div>
      <div class="role">Full Stack Developer</div>
      <div class="top-line"></div>

      <div class="section">
        <div class="heading"><div class="icon"><i class="fas fa-user"></i></div><h2>Professional Summary</h2></div>
        <p class="summary"><%= data.summary %></p>
      </div>

      <div class="section">
        <div class="heading"><div class="icon"><i class="fas fa-briefcase"></i></div><h2>Experience</h2></div>
        <% data.experience.forEach(exp => { %>
          <div class="exp-item">
            <h3><%= exp.title %></h3>
            <p><%= exp.company %></p>
            <p><%= exp.startDate %> - <%= exp.endDate %></p>
            <p><%= exp.responsibilities %></p>
          </div>
        <% }) %>
      </div>

      <div class="section project">
        <div class="heading"><div class="icon"><i class="fas fa-code"></i></div><h2>Projects</h2></div>
        <h3><%= data.projectTitle %></h3>
        <p><%= data.projectDescription %></p>
        <p><strong>Tech:</strong> <%= data.projectTech %></p>
        <% if (data.projectLink) { %>
          <a href="<%= data.projectLink %>"><%= data.projectLink %></a>
        <% } %>
      </div>

      <div class="section reference">
        <div class="heading"><div class="icon"><i class="fas fa-user"></i></div><h2>Reference</h2></div>
        <h3><%= data.refName1 %></h3>
        <p><%= data.refRelation1 %></p>
        <p>Contact: <%= data.refContact1 %></p>
      </div>
    </div>
  </div>
       <form action="/resume/<%=data._id%>/edit">
        <div class="resume-actions">
    <button onclick="window.location.href='/resume/edit/<%= data._id %>'">
      <i class="fas fa-edit"></i> Edit
  </div>
       </form>
       <form action="">
        <div class="resume-actions">
         </button>
    <button onclick="window.print()">
      <i class="fas fa-print"></i> Print
    </button>
       </form>
         </div>
</body>
</html>
