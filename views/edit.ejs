<% layout("/layouts/boilerplate") %>
<body>
  <style>
    body {
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
    }

    .form-container {
      max-width: 900px;
      margin: 40px auto;
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.1);
    }

    h2 {
      text-align: center;
      color: #333;
      margin-bottom: 20px;
    }

    h4 {
      margin-top: 30px;
      color: #444;
      border-left: 4px solid #0078d7;
      padding-left: 8px;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      color: #555;
    }

    input, textarea {
      width: 100%;
      padding: 10px;
      margin-bottom: 15px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 14px;
      transition: border-color 0.3s ease;
    }

    input:focus, textarea:focus {
      border-color: #0078d7;
      outline: none;
    }

    .row {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }

    .col {
      flex: 1;
      min-width: 250px;
    }

    button {
      background: #0078d7;
      color: #fff;
      border: none;
      padding: 12px 20px;
      font-size: 16px;
      border-radius: 6px;
      cursor: pointer;
      transition: background 0.3s ease;
      width: 100%;
    }

    button:hover {
      background: #005fa3;
    }
  </style>

  <div class="form-container">
    <h2>Edit Resume</h2>
    <form action="/resume/<%=data._id%>/edit?_method=PUT" method="post">

      <div class="row">
        <div class="col">
          <label for="profileImage">Profile Image URL</label>
          <input type="text" id="profileImage" name="profileImage" value="<%= data.profileImage %>" required>
        </div>
        <div class="col">
          <label for="name">Full Name</label>
          <input type="text" id="name" name="name" value="<%= data.name %>" required>
        </div>
      </div>

      <div class="row">
        <div class="col">
          <label for="phone">Phone</label>
          <input type="text" id="phone" name="phone" value="<%= data.phone %>" required>
        </div>
        <div class="col">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= data.email %>" required>
        </div>
      </div>

      <label for="address">Address</label>
      <input type="text" id="address" name="address" value="<%= data.address %>" required>

      <div class="row">
        <div class="col">
          <label for="linkedin">LinkedIn</label>
          <input type="url" id="linkedin" name="linkedin" value="<%= data.linkedin %>">
        </div>
        <div class="col">
          <label for="github">GitHub</label>
          <input type="url" id="github" name="github" value="<%= data.github %>">
        </div>
      </div>

      <label for="summary">Summary</label>
      <textarea id="summary" name="summary" rows="4" required><%= data.summary %></textarea>

      <h4>Education</h4>
      <div class="row">
        <div class="col">
          <label>Degree</label>
          <input type="text" name="education[0][degree]" value="<%= data.education[0].degree %>">
        </div>
        <div class="col">
          <label>Institution</label>
          <input type="text" name="education[0][institution]" value="<%= data.education[0].institution %>">
        </div>
      </div>
      <div class="row">
        <div class="col">
          <label>Year</label>
          <input type="text" name="education[0][year]" value="<%= data.education[0].year %>">
        </div>
        <div class="col">
          <label>Specialization</label>
          <input type="text" name="education[0][specialization]" value="<%= data.education[0].specialization %>">
        </div>
      </div>

      <h4>Skills</h4>
      <% data.skills.forEach(skill => { %>
        <input type="text" name="skills[]" value="<%= skill %>">
      <% }) %>

      <h4>Experience</h4>
      <div class="row">
        <div class="col">
          <label>Job Title</label>
          <input type="text" name="experience[0][title]" value="<%= data.experience[0].title %>">
        </div>
        <div class="col">
          <label>Company</label>
          <input type="text" name="experience[0][company]" value="<%= data.experience[0].company %>">
        </div>
      </div>
      <div class="row">
        <div class="col">
          <label>Start Date</label>
          <input type="text" name="experience[0][startDate]" value="<%= data.experience[0].startDate %>">
        </div>
        <div class="col">
          <label>End Date</label>
          <input type="text" name="experience[0][endDate]" value="<%= data.experience[0].endDate %>">
        </div>
      </div>
      <label>Responsibilities</label>
      <textarea name="experience[0][responsibilities]" rows="3"><%= data.experience[0].responsibilities %></textarea>

      <h4>Project</h4>
      <label>Project Title</label>
      <input type="text" name="projectTitle" value="<%= data.projectTitle %>">
      <label>Project Description</label>
      <textarea name="projectDescription" rows="3"><%= data.projectDescription %></textarea>
      <label>Technologies</label>
      <input type="text" name="projectTech" value="<%= data.projectTech %>">
      <label>Project Link</label>
      <input type="url" name="projectLink" value="<%= data.projectLink %>">

      <h4>Hobbies</h4>
      <input type="text" name="hobby1" value="<%= data.hobby1 %>">
      <input type="text" name="hobby2" value="<%= data.hobby2 %>">
      <input type="text" name="hobby3" value="<%= data.hobby3 %>">

      <h4>Reference</h4>
      <div class="row">
        <div class="col">
          <label>Name</label>
          <input type="text" name="refName1" value="<%= data.refName1 %>">
        </div>
        <div class="col">
          <label>Contact</label>
          <input type="text" name="refContact1" value="<%= data.refContact1 %>">
        </div>
        <div class="col">
          <label>Relation</label>
          <input type="text" name="refRelation1" value="<%= data.refRelation1 %>">
        </div>
        <!-- <div class="col">
          <label>Template-Id</label>
          <input type="text" name="tempId" value="<%= data.tempId %>">
        </div> -->
      </div>

      <button>Update Resume</button>
    </form>
  </div>
</body>
