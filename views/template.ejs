<% layout("/layouts/boilerplate") %>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}
body{
background:#edf1ea;
padding:30px;
}
.resume{
max-width:1000px;
margin:auto;
background:#fff;
border-radius:30px;
overflow:hidden;
box-shadow:0 15px 35px rgba(0,0,0,.08);
}
.header{
display:grid;
grid-template-columns:1.2fr 180px 1fr;
gap:25px;
padding:35px;
align-items:center;
background:#f8f7f2;
}
.hero{
background:linear-gradient(135deg,#234b37,#2f6244);
color:white;
padding:35px;
border-radius:0 0 40px 0;
}
.hero h1{
font-size:55px;
line-height:52px;
}
.hero h1 span{font-weight:300;}
.hero h3{
margin-top:15px;
letter-spacing:3px;
color:#e8d6b0;
}
.line{
width:70px;
height:4px;
background:#e8d6b0;
border-radius:5px;
margin:18px 0;
}
.hero p{
font-size:14px;
line-height:1.8;
}
.profile img{
width:170px;
height:170px;
object-fit:cover;
border-radius:50%;
border:8px solid white;
box-shadow:0 0 0 5px #d8c29c;
}
.contact div{
display:flex;
align-items:center;
gap:12px;
margin:18px 0;
font-size:15px;
color:#234b37;
}
.contact i{
width:40px;
height:40px;
display:flex;
align-items:center;
justify-content:center;
background:#234b37;
color:white;
border-radius:50%;
}
.main{
display:grid;
grid-template-columns:1.15fr .95fr;
gap:25px;
padding:35px;
background:#fbfaf6;
}
.title{
display:flex;
align-items:center;
gap:15px;
margin-bottom:20px;
}
.title span{
width:50px;
height:50px;
background:#3d7a57;
color:white;
display:flex;
align-items:center;
justify-content:center;
border-radius:50%;
}
.title h2{
color:#214933;
font-size:22px;
position:relative;
}
.title h2::after{
content:"";
display:inline-block;
width:100px;
height:2px;
background:#7c9c89;
margin-left:15px;
vertical-align:middle;
}
.job{
margin-bottom:35px;
}
.row{
display:flex;
justify-content:space-between;
gap:20px;
}
.job h3,.edu h3{
font-size:26px;
color:#163425;
}
.job h4,.edu p{
font-size:18px;
font-weight:400;
color:#4d5a54;
}
.date{
font-size:14px;
text-align:right;
color:#4d5a54;
}
ul{
padding-left:22px;
margin-top:15px;
}
li{
margin:12px 0;
line-height:1.7;
color:#42544c;
}
li::marker{
color:#6b9a7d;
}
.card{
background:#eef1e8;
padding:25px;
border-radius:25px;
margin-bottom:20px;
}
.skills{
display:grid;
grid-template-columns:1fr 1fr;
gap:10px;
}
.skills span{
background:#dde5d8;
padding:10px;
border-radius:25px;
text-align:center;
font-size:14px;
color:#274434;
}
.project{
margin-top:20px;
}
.project ul{
margin-top:8px;
}
.lang{
display:grid;
gap:15px;
}
.bar{
height:8px;
background:#d9d9d9;
border-radius:10px;
overflow:hidden;
margin-top:5px;
}
.bar span{
display:block;
height:100%;
background:#2f6b4b;
border-radius:10px;
}
.icons{
display:grid;
grid-template-columns:repeat(4,1fr);
text-align:center;
margin-top:20px;
}
.icons i{
font-size:25px;
color:#2c6b49;
margin-bottom:8px;
}
.icons p{
font-size:13px;
}
.quote{
font-size:36px;
font-family:cursive;
color:#2c6b49;
margin-top:60px;
line-height:1.2;
transform:rotate(-8deg);
}
@media(max-width:900px){
.header{grid-template-columns:1fr;text-align:center;}
.profile{order:-1;}
.contact div{justify-content:center;}
.main{grid-template-columns:1fr;}
.row{flex-direction:column;}
.date{text-align:left;}
.skills{grid-template-columns:1fr;}
.icons{grid-template-columns:repeat(2,1fr);}
}
.resume-actions {
      max-width: 1000px;
      margin: 20px auto;
      text-align: right;
    }
    .resume-actions button {
      background: #0078d7;
      color: #fff;
      border: none;
      padding: 10px 18px;
      margin-left: 10px;
      border-radius: 6px;
      font-size: 14px;
      cursor: pointer;
      transition: background 0.3s;
    }
    .resume-actions button:hover {
      background: #005fa3;
    }
    .resume-actions i {
      margin-right: 6px;
    }

  /* RESPONSIVE */
  @media (max-width: 850px) {
    .resume {
      grid-template-columns: 1fr;
    }
    .left {
      text-align: center;
    }
    .contact div {
      justify-content: center;
    }
  }
</style>
<!-- Header -->
 <body>
    
 
<div class="hero">
    <h1><%= data.name %></h1>
    <h3>SOFTWARE DEVELOPER</h3>
    <div class="line"></div>
    <p><%= data.summary %></p>
</div>

<!-- Profile -->
<div class="profile">
    <img src="<%= data.profileImage.url %>" alt="Profile">
</div>

<!-- Contact -->
<div class="contact">
    <div><i class="fas fa-envelope"></i> <%= data.email %></div>
    <div><i class="fas fa-phone"></i> <%= data.phone %></div>
    <div><i class="fas fa-location-dot"></i> <%= data.address %></div>
    <div><i class="fab fa-linkedin"></i> <%= data.linkedin %></div>
    <div><i class="fab fa-github"></i> <%= data.github %></div>
</div>

<!-- Experience -->
<div class="job">
    <div class="row">
        <div>
            <h3><%= data.experience %></h3>
        </div>
    </div>
</div>

<!-- Education -->
<div class="edu">
    <h3><%= data.education %></h3>
</div>

<!-- Skills -->
<div class="card">
    <div class="title">
        <span><i class="fas fa-gear"></i></span>
        <h2>SKILLS</h2>
    </div>

    <div class="skills">
        <span><%= data.skills %></span>
    </div>
</div>

<!-- Project -->
<div class="card">
    <div class="title">
        <span><i class="fas fa-code"></i></span>
        <h2>PROJECT</h2>
    </div>

    <div class="project">
        <div class="row">
            <h3><%= data.projectTitle %></h3>
        </div>

        <ul>
            <li><%= data.projectDescription %></li>
            <li>Tech: <%= data.projectTech %></li>
            <li><%= data.projectLink %></li>
        </ul>
    </div>
</div>

<!-- Hobbies -->
<div class="card">
    <div class="title">
        <span><i class="fas fa-star"></i></span>
        <h2>HOBBIES</h2>
    </div>

    <div class="icons">
        <div><i class="fas fa-heart"></i><p><%= data.hobby1 %></p></div>
        <div><i class="fas fa-heart"></i><p><%= data.hobby2 %></p></div>
        <div><i class="fas fa-heart"></i><p><%= data.hobby3 %></p></div>
    </div>
</div>

<!-- Reference -->
<div class="card">
    <div class="title">
        <span><i class="fas fa-user"></i></span>
        <h2>REFERENCE</h2>
    </div>

    <p><strong><%= data.refName1 %></strong></p>
    <p><%= data.refRelation1 %></p>
    <p><%= data.refContact1 %></p>
</div>
 <form action="/resume/<%=data._id%>/edit">
        <div class="resume-actions">
    <button onclick="window.location.href='/resume/edit/<%= data._id %>'">
      <i class="fas fa-edit"></i> Edit
  </div>
       </form>
       <form action="">
        <div class="resume-actions">
         </button>
    <button onclick="window.print()">
      <i class="fas fa-print"></i> Print
    </button>
       </form>
         </div>
        </body>
